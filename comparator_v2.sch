C {code_shown.sym} -420 -480 0 0 {name=s1 only_toplevel=false value=".control
let lsb = 0.1125
let ref = 0.1125

echo Reference_V Switching_V Offset_V

dowhile ref <= 1.6875
   alter V3 $&ref
   let start = ref - 0.06
   let stop = ref + 0.06

   dc V2 $&start $&stop 0.005
   meas dc vsw WHEN v(out_dig)=0.9 FALL=1

   let offset = vsw - ref
   print ref vsw offset 
	
   let ref = ref + lsb

end
.endc"}
